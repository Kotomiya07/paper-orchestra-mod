# Export these variables in your shell. Do not write credentials to a file.
# LLM_BACKEND: openai | agy | t3 | gemini
LLM_BACKEND=openai
PAPER_ORCHESTRA_CPA=1
# Set to 1 on the Muse VM; leave at 0 on the tailnet.
PAPER_ORCHESTRA_CPA_TUNNEL=0
OPENAI_BASE_URL=http://m4-mac-mini-32gb.tail5df0ca.ts.net:8317/v1
# CPA falls back to env.ANTHROPIC_AUTH_TOKEN in ~/.claude/settings.json.
OPENAI_API_KEY=
# CPA CLI model examples: preview/DeepSeek-V4.1-Flash-1017, gpt-5.6-luna, claude-sonnet-5-5

# For Antigravity CLI text generation, set LLM_BACKEND=agy.
# Model examples: gemini-3.8-flash-high, gemini-3.8-flash-medium, gemini-3.8-flash-low,
# claude-sonnet-4-6, claude-opus-4-6-thinking, gpt-oss-120b-medium
# About 8,500 extra input tokens per call; no images, PDFs, or tools.
AGY_BIN=

# For T3 Code, set LLM_BACKEND=t3 or set LLM_BACKEND_MULTIMODAL=t3
# to send only image/PDF requests to T3. Run on the T3 server host.
LLM_BACKEND_MULTIMODAL=
# Optional provider:model override for images/PDF, e.g. antigravity:gemini-4-neon.
LLM_MULTIMODAL_MODEL=
T3_PROJECT_DIR=
T3_BIN=
T3_DEFAULT_PROVIDER=antigravity
T3_CALL_TIMEOUT=900
# T3 calls can take minutes and consume the provider's shared quota.

OPENALEX_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=

# For native Gemini (optional):
# GEMINI_API_KEY=
# VERTEX_AI_PROJECT=
# VERTEX_AI_LOCATION=
